# ==============================================================================
# 🏢 Blogin 365 AI Holdings - Environment Configuration Template (.env.example)
# ==============================================================================

# =========================================
# 🧠 Phase 1: AI 두뇌 및 본진 (필수 작성)
# =========================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 구글 블로거 (메인 수익 창출 본진)
BLOGGER_BLOG_ID=2002031376804677477

# =========================================
# 🔍 Trick B: Google CSE (맞춤검색) & AdSense for Search (AFS) 연동
# =========================================
# 구글 맞춤검색 엔진 ID (Google Programmable Search Engine CX)
# - 설정 시: 공식 구글 CSE 스크립트 + AFS 맞춤검색 광고 위젯 렌더링
# - 미설정 시: 블로그 자체 검색 URL (https://blogin365ai.blogspot.com/search?q=...) 무중단 자동 폴백
GOOGLE_CSE_CX=

# =========================================
# 🚀 Phase 2 & 3: 멀티 플랫폼 확장 (선택 사항)
# =========================================
# 티스토리 확장용
TISTORY_ACCESS_TOKEN=
TISTORY_BLOG_NAME=

# 워드프레스 독립용
WP_URL=
WP_USERNAME=
WP_PASSWORD=

# 네이버 블로그 (트래픽 유도용 백링크)
NAVER_ID=
NAVER_PW=

# 검색엔진 자동 등록 API (SEO 가속기)
NAVER_SEARCH_ADVISOR_API=
GOOGLE_INDEXING_API=

OPENAI_API_KEY=

# =========================================
# 📡 Social Distribution Webhooks (Phase 6)
# =========================================
THREADS_WEBHOOK_URL=
X_WEBHOOK_URL=
MANYCHAT_WEBHOOK_URL=
KAKAO_VIEW_WEBHOOK_URL=
